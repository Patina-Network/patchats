  <table
    align="center"
    width="100%"
    border="0"
    cellpadding="0"
    cellspacing="0"
    role="presentation"
    style="background-color:#f6f9fc;font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif">
    <tbody>
      <tr>
        <td>
          <table
            align="center"
            width="100%"
            border="0"
            cellpadding="0"
            cellspacing="0"
            role="presentation"
            style="background-color:#ffffff;margin:40px auto;padding:20px;border-radius:6px;max-width:600px">
            <tbody>
              <tr>
                <td>
                  <span
                    style="background-color:#0070f3;border-radius:4px;color:white;display:inline-block;font-size:12px;font-weight:bold;padding:4px 8px;text-transform:uppercase"
                    >PatChats</span
                  >
                  <h1
                    style="color:#333333;font-size:24px;font-weight:bold;margin:20px 0">
                    Hello,<!-- -->
                    <span id="input-recipientName-innerText"> </span>!
                  </h1>
                  <p
                    style="font-size:16px;line-height:24px;color:#555555;margin:10px 0;margin-top:10px;margin-right:0;margin-bottom:10px;margin-left:0">
                    Thank you for signing up for <span>PatChats</span>. Please
                    verify your email address by clicking the button below.
                  </p>
                  <a
                    id="input-verifyUrl-href"
                    style="color:white;text-decoration-line:none;background-color:#0070f3;border-radius:4px;display:inline-block;font-size:16px;font-weight:bold;padding:12px 24px;text-decoration:none"
                    target="_blank"
                    >Verify Email</a
                  >
                  <div
                    style="background-color:#f0f0f0;border-radius:4px;color:#555555;font-size:14px;margin-top:20px;padding:10px;word-break:break-all"
                    id="input-verifyUrl-innerText"></div>
                  <p
                    style="font-size:16px;line-height:24px;color:#555555;margin:10px 0;margin-top:10px;margin-right:0;margin-bottom:10px;margin-left:0">
                    This link will expire in 1 hour.
                  </p>
                  <p
                    style="font-size:16px;line-height:24px;color:#555555;margin:10px 0;margin-top:10px;margin-right:0;margin-bottom:10px;margin-left:0">
                    If you have any questions, please contact us at<!-- -->
                    <a
                      id="input-supportEmail-href"
                      style="color:#067df7;text-decoration-line:none"
                      target="_blank"
                      ><span id="input-supportEmail-innerText"></span></a
                    >.
                  </p>
                </td>
              </tr>
            </tbody>
          </table>
        </td>
      </tr>
    </tbody>
  </table>
